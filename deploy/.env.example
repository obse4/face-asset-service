# face-assets 环境变量样例：复制为 .env 后按需修改（不要把 .env 提交进 Git）
#
# 端口：8783（已确认在 192.168.9.21 上空闲；8780/8781/8782/8790/8080/8188/8288/8388/8488/3000 已被占用）

# 宿主机暴露端口
FACE_ASSETS_HOST_PORT=8783

# 只读权重目录（宿主路径 → 容器内 /srv/face-assets/models）
FACE_ASSETS_MODELS_HOST_DIR=/srv/face-assets/models

# 嵌入模型：auraface（**默认**，512 维，260MB）或 sface（128 维，39MB，快 4.2 倍）
#
# 为什么默认 AuraFace：实测在本项目素材上，SFace 的"同一人最低余弦"(+0.374) 竟**低于**
# "不同人最高余弦"(+0.399) —— 裕度为负，**不存在任何阈值能分开**；AuraFace 则是
# 同一人最低 +0.587 / 不同人最高 +0.209，裕度 +0.378。详见 deploy/face-assets/PLAN.md §4.6。
# 仅在"只要速度、不在乎身份可分性"的用途下才改回 sface。
FACE_ASSETS_EMBEDDING_MODEL=auraface

# 质量门控：检测置信度下限与人脸像素宽下限。
# 实测依据（episode_008）：门控 0.85 + 100px 会排除"带 VFX 叠影的帧"（置信 0.80）与
# "80px 低置信误检"（置信 0.61），而保留清晰的正面照。若要提高召回可下调，但要接受更多噪声。
FACE_ASSETS_MIN_SCORE=0.85
FACE_ASSETS_MIN_FACE_PX=100

# 单帧最多返回的人脸数
FACE_ASSETS_MAX_FACES=32

# 鉴权：留空则不启用（只应部署在可信内网）。建议设置。
FACE_ASSETS_API_KEY=

# CPU 线程上限（当好邻居：不要把整机 144 核吃满）
FACE_ASSETS_THREADS=4

# 启动时预热模型（避免首个真实请求承担加载时延）
FACE_ASSETS_WARMUP=1

FACE_ASSETS_LOG_LEVEL=info
